# Which Higgsfield backend to use:
#   mcp (default) — official MCP server; click "Conectar Higgsfield" in the app to log in.
#                   Uses your plan credits and the Nano Banana 2.1 / Kling 4.0 models.
#   api           — REST API with an API key and prepaid balance.
HF_BACKEND=mcp

# Only for HF_BACKEND=api: key from https://console.higgsfield.ai, exactly as shown ("<id>:<secret>")
HF_API_KEY=

# Optional: swap the models without touching code.
# HF_IMAGE_ENDPOINT=/xai/grok-imagine-image-2.0
# HF_VIDEO_ENDPOINT=/kling-video/o3/image-reference

# Optional (MCP): swap models
# HF_MCP_IMAGE_MODEL=nano_banana_2_1
# HF_MCP_VIDEO_MODEL=kling4_0

# Active Record encryption keys (protect the OAuth tokens). Generate with:
#   ruby -rsecurerandom -e '3.times { puts SecureRandom.alphanumeric(32) }'
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

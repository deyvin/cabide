<%# Floating bar that appears once at least one ready garment is selected. %>
<div data-selection-target="bar" hidden
     class="fixed inset-x-0 bottom-4 z-40 flex justify-center px-4">
  <%= form_with url: videos_path, data: { selection_target: "form", turbo: false },
        class: "animate-rise flex w-full max-w-2xl flex-wrap items-center gap-3 rounded-[1.75rem] bg-ink p-2 pl-5 text-paper shadow-[0_20px_50px_rgb(22_20_18/0.35)] sm:flex-nowrap" do %>
    <div data-selection-target="inputs" hidden></div>

    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium"><span data-selection-target="count">0</span> no look</p>
      <p class="label text-paper/60" data-selection-target="hint">Um vídeo com alguém vestindo tudo junto</p>
    </div>

    <fieldset class="flex rounded-full bg-white/10 p-1" aria-label="Duração do vídeo">
      <% Video::DURATIONS.each do |seconds| %>
        <label class="cursor-pointer">
          <input type="radio" name="duration" value="<%= seconds %>" class="peer sr-only" <%= "checked" if seconds == 5 %>>
          <span class="block rounded-full px-3 py-1.5 font-mono text-xs text-paper/70 transition peer-checked:bg-paper peer-checked:text-ink peer-focus-visible:ring-2 peer-focus-visible:ring-paper">
            <%= seconds %> s
          </span>
        </label>
      <% end %>
    </fieldset>

    <button type="button" data-action="selection#clear" class="h-11 rounded-full px-3 text-sm text-paper/70 hover:text-paper cursor-pointer">Limpar</button>
    <button type="submit" data-selection-target="submit"
            class="inline-flex h-11 items-center gap-2 rounded-full bg-chalk px-5 text-sm font-medium text-white transition hover:brightness-110 active:scale-[0.98] disabled:opacity-40 cursor-pointer">
      Gerar vídeo
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
    </button>
  <% end %>
</div>
